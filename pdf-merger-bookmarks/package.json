{
  "name": "pdf-merger-bookmarks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-release.mjs",
    "test:unit": "node --test tests/bookmarks.test.mjs",
    "test:e2e": "python scripts/generate_fixtures.py && node tests/e2e.mjs && python scripts/verify_output.py",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
